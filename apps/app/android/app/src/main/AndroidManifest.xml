<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Mở khóa app bằng sinh trắc học. Không xin quyền mạng/vị trí: ảnh và chữ không rời máy (ADR-0002). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Quét bằng camera (P6). Hỏi lúc mở màn Quét lần đầu, không hỏi khi khởi động. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Quyền tối thiểu: plugin camera tự khai báo ghi âm (quay video) và ghi bộ nhớ ngoài - app không quay video, ảnh
         chụp được đọc vào bộ nhớ rồi xóa ngay khỏi thư mục cache riêng của app ⇒ gỡ cả hai khỏi manifest đã gộp. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <!-- Trình gộp manifest tự suy ra READ_EXTERNAL_STORAGE từ quyền ghi ở trên; media3-common (phần quay video của
         CameraX) khai ACCESS_NETWORK_STATE. App không đọc bộ nhớ ngoài, không quay video, không dùng mạng ⇒ gỡ. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <!-- Máy không có camera (máy tính bảng, Chromebook) vẫn cài được và nhập ảnh có sẵn. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" tools:replace="android:required" />
    <application
        android:label="Tsu Scan"
        android:name="${applicationName}"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
